# Default mode opens an actual email draft. No server or API key needed.
VITE_CONTACT_MODE=mailto

# Optional: switch the above to api for direct delivery on Vercel.
# These server values MUST NOT have the VITE_ prefix.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=hailegebrielsamuel@gmail.com
CONTACT_ALLOWED_ORIGIN=https://hailegebriel.vercel.app
